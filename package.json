{
	"name": "obsidian-mermaid-viewer",
	"version": "0.1.0",
	"description": "GitHub-style controls for Mermaid diagrams rendered by Obsidian.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
		"lint": "eslint .",
		"test": "vitest run",
		"test:watch": "vitest",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"mermaid",
		"zoom",
		"pan"
	],
	"author": "ives",
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"@typescript-eslint/types": "8.55.0",
		"@typescript-eslint/utils": "8.55.0",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.1",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"jsdom": "26.1.0",
		"obsidian": "^1.13.1",
		"typescript": "^5.8.3",
		"typescript-eslint": "8.55.0",
		"vitest": "^4.1.10"
	}
}
